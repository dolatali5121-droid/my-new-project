# StudyFlow — static hosting config for Hostinger (Apache / LiteSpeed)
# Place this file in the same folder as index.html.

DirectoryIndex index.html

# ---- Compression: sends CSS/JS ~70% smaller ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching: assets cached, HTML always revalidated ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml    "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---- Force HTTPS ----
# Uncomment the block below ONLY AFTER your SSL certificate shows as active in
# hPanel (Websites -> Security -> SSL). Enabling it beforehand causes a
# redirect loop and the site will not load.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
